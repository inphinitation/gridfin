# Script mode helper for EmbedFiles.cmake. Inputs: OUTPUT, NAMESPACE, FILES.
# Files are emitted as byte arrays, which sidesteps MSVC's string literal limits.

set(content "// Generated by cmake/EmbedFilesScript.cmake. Do not edit.\n#pragma once\n\n#include <string_view>\n\nnamespace ${NAMESPACE} {\n")

foreach(file IN LISTS FILES)
    get_filename_component(stem "${file}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${stem}" ident)
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR byte_count "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "char(0x\\1)," bytes "${hex}")
    string(REGEX REPLACE "((char\\(0x[0-9a-f][0-9a-f]\\),){16})" "\\1\n    " bytes "${bytes}")
    string(APPEND content
        "\ninline constexpr char ${ident}_data[] = {\n    ${bytes}char(0)};\n"
        "inline constexpr std::string_view ${ident}{${ident}_data, ${byte_count}};\n")
endforeach()

string(APPEND content "\n} // namespace ${NAMESPACE}\n")

# Only touch the output when it changed to avoid needless recompiles.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
